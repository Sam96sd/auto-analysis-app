# 🔒 تسجيل الدخول بحساب Google (إلزامي عند النشر)
# سر توقيع جلسات الدخول — نص عشوائي طويل 32 حرفاً على الأقل، لا تشاركه مع أحد.
AUTH_SECRET=

# من Google Cloud Console → Google Auth Platform → Clients
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# مفتاح Twelve Data (اختياري لكنه مستحسن) — سجّل مجاناً من https://twelvedata.com
# عند وجوده يعرض الموقع السعر الفوري لـ XAU/USD مباشرة.
# بدونه يستخدم الموقع Yahoo Finance (بدون مفتاح)، وإن فشل يعرض بيانات تجريبية مع تنبيه واضح.
TWELVE_DATA_API_KEY=

# ضع 1 لتعطيل Binance الاحتياطي
DISABLE_BINANCE=

# ضع 1 لتعطيل Yahoo Finance (مثلاً إذا كان محجوباً من الخادم)
DISABLE_YAHOO=
